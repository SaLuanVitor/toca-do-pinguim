{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toca do Pinguim",
  "version": "../package.json",
  "identifier": "com.luan.tocadopinguim",
  "build": {
    "beforeDevCommand": "npm run agente && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run agente && npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Toca do Pinguim",
        "width": 1100,
        "height": 720,
        "minWidth": 640,
        "minHeight": 420,
        "transparent": true,
        "windowEffects": {
          "effects": ["mica"]
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "publisher": "SaLuanVitor",
    "windows": {
      "nsis": {
        "installerHooks": "./windows/hooks.nsh"
      }
    },
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEM4QUYzN0ZDMjdEQjk2OTkKUldTWmx0c24vRGV2eU9kNHE3UVVDNEhDM3hoenk0WHRSVStBZjJHVWljMVp4d1RCdGdZRm11d00K",
      "endpoints": [
        "https://github.com/SaLuanVitor/toca-do-pinguim/releases/latest/download/latest.json"
      ],
      "windows": { "installMode": "passive" }
    }
  }
}
